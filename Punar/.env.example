# Punar — Demo Environment Variables
# Copy this file to .env and fill in values as needed.
# Do NOT commit .env to git.

# ─────────────────────────────────────────────────────────────
# Production-like database (V1 schema + seed data)
# Started by: docker-compose -f database/docker-compose.yml up -d
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://punar:punar@localhost:5432/payment_service

# ─────────────────────────────────────────────────────────────
# Ephemeral rehearsal database (cloned before each rollback check)
# ─────────────────────────────────────────────────────────────
REHEARSAL_DATABASE_URL=postgresql://punar:punar@localhost:5433/payment_service_rehearsal

# ─────────────────────────────────────────────────────────────
# Service ports
# ─────────────────────────────────────────────────────────────
V1_PORT=3010
V2_PORT=3011
BACKEND_PORT=3001
